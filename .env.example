# === 运行模式 ===
# 模拟模式: 无 SDR 硬件时使用预设音频测试
MOCK_MODE=false

# 强制 CPU 模式: 无 GPU 或显存不足时启用
NO_GPU=false

# === ASR 配置 ===
# Whisper 模型大小: tiny, base, small, medium, large-v3
MODEL_SIZE=medium

# whisper: 正式识别; mock: 仅用于硬件/API 链路验收
ASR_BACKEND=whisper

# 计算类型: int8 (CPU推荐), int8_float16 (GPU推荐), float16, float32
COMPUTE_TYPE=int8_float16

# CPU 推理线程数
CPU_THREADS=4

# ASR 噪声过滤: Whisper 识别为空/低置信时丢弃片段
ASR_NO_SPEECH_THRESHOLD=0.6
ASR_AVG_LOGPROB_THRESHOLD=-1.0
ASR_CONDITION_ON_PREVIOUS_TEXT=false

# 真实模式下 Whisper 初始化失败是否允许退回 MockASR
# 落地/验收建议保持 false；只有演示兜底时改 true
ALLOW_MOCK_FALLBACK=false

# === 音频配置 ===
# audio: 从虚拟声卡采集; rtl: 直接读取 RTL-SDR IQ 并在 Python 内做 NFM 解调
SDR_SOURCE=audio

# 音频设备索引 (None=自动检测)
AUDIO_DEVICE=

# RTL-SDR 直连模式配置 (SDR_SOURCE=rtl)
RTL_FREQUENCY_MHZ=438.500
RTL_CHANNEL_ID=ch-main
RTL_SAMPLE_RATE=1024000
RTL_SQUELCH_SNR_DB=8.0
# 未校准接收棒仅能给出估算 dBm，可按实测仪表调整偏移
RTL_RSSI_OFFSET_DB=-50.0
# 留空时自动使用 tools/sdr/sdrpp/sdrpp_windows_x64/rtlsdr.dll
RTL_DLL_PATH=

# 语音片段保存目录
SEGMENTS_DIR=./segments

# === 无线电多频道态势 ===
# 格式: id|名称|频率MHz|调制;id|名称|频率MHz|调制
RADIO_CHANNELS=ch-main|应急主信道|438.500|NFM;ch-fire|消防联动|438.650|NFM;ch-rescue|救援保障|439.125|NFM;ch-command|指挥备频|439.350|NFM

# 超过多少秒未收到频道遥测/通联后标为中断
RADIO_STALE_AFTER_SECONDS=8.0

# === 模拟模式配置 ===
# 模拟音频目录
MOCK_AUDIO_DIR=./mock_audio

# 模拟推送间隔(秒)
MOCK_INTERVAL=5.0

# === 服务配置 ===
# API 端口
PORT=8000

# CORS 白名单,逗号分隔；留空则允许所有来源但不带 credentials
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# 写操作鉴权；为空则不校验
ADMIN_TOKEN=

# 前端构建期写入的管理 token；开启 ADMIN_TOKEN 且由 Vite 直连后端时需要一致
VITE_ADMIN_TOKEN=

# === 前端真实地图底图(可选) ===
# 留空时使用内置上海离线矢量图；填 amap 或 baidu 后接入在线真实地图。
# 高德 JS API 2.0: 需要 Web 端(JS API) Key；2021-12-02 后申请的 Key 通常还需要安全密钥。
VITE_MAP_PROVIDER=
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
# 百度地图 JavaScript API GL: 需要浏览器端 AK。
VITE_BAIDU_AK=

# === 持久化 ===
STORAGE_PATH=./data/emergency-radio-agent.sqlite3

# === LLM 慢通道(可选,默认关闭) ===
LLM_FALLBACK_ENABLED=false
LLM_SUMMARY_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT=4.0
LLM_CONFIDENCE_THRESHOLD=0.58
